    "    'Wind': 'Renewable', 'Solar': 'Renewable', 'Other Renewables': 'Renewable'\n",
    "}\n",
    "df['Source_Type'] = df['Source'].map(source_category)\n",
    "\n",
    "print(f\"Loaded: {len(df)} rows\")\n",
    "print(df.head(10))"
   ]
