    "import pandas as pd\n",
    "import plotly.express as px\n",
    "import numpy as np\n",
    "\n",
    "# Dataset: Global Energy Mix by Country and Source\n",
    "df = pd.read_csv(r\"C:\\Users\\asala\\OneDrive\\Documents\\data-viz-class-material\\data\\global_energy_mix.csv\")\n",
